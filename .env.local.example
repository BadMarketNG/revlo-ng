# ── Supabase ───────────────────────────────────────────────
# From Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://gwpaenseymdjbedhhuer.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Email (Resend) ─────────────────────────────────────────
# From resend.com -> API Keys. Leave blank in dev to skip sending.
RESEND_API_KEY=
EMAIL_FROM=Revlo.ng <noreply@revlo.ng>

# ── Storage ────────────────────────────────────────────────
STORAGE_BUCKET=media

# ── App ────────────────────────────────────────────────────
APP_URL=http://localhost:3000
BADMARKET_URL=https://badmarket.ng

# ── Secrets (generate random strings) ──────────────────────
# Run:  openssl rand -hex 32
TOKEN_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-to-another-random-string
