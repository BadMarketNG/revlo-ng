# ── Supabase ───────────────────────────────────────────────
# From Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://gwpaenseymdjbedhhuer.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Email (Amazon SES) ─────────────────────────────────────
# IAM user limited to ses:SendEmail, in the region where revlo.ng is a
# verified identity. Leave blank in dev to skip sending.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Optional: SES configuration set for bounce/complaint tracking.
SES_CONFIGURATION_SET=
EMAIL_FROM=Revlo.ng <noreply@revlo.ng>

# ── Storage ────────────────────────────────────────────────
STORAGE_BUCKET=media

# ── App ────────────────────────────────────────────────────
APP_URL=http://localhost:3000
BADMARKET_URL=https://badmarket.ng

# ── Secrets (generate random strings) ──────────────────────
# Run:  openssl rand -hex 32
TOKEN_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-to-another-random-string
